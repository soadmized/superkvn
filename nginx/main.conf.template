server {
  listen 80;
  server_name ${DOMAIN} www.${DOMAIN};

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
    listen 443 ssl;
    server_name ${DOMAIN} www.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    root /usr/share/nginx/html;
    index index.html;

    # админка 3x-ui
    location /${UI_DUMMY_PATH}/${UI_PATH}/ {
        proxy_pass http://xray:${UI_PORT}/${UI_DUMMY_PATH}/${UI_PATH}/;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 3600;
        proxy_send_timeout 3600;
    }

    # Редирект для админки без слеша
    location = /${UI_DUMMY_PATH}/${UI_PATH} {
        return 301 /${UI_DUMMY_PATH}/${UI_PATH}/;
    }

    # основной сайт
    location / {
        try_files $uri $uri/ =404;
    }

    # пустышка
    location = /${UI_DUMMY_PATH} {
        return 204;
    }

    # для подключений
    location /${NETWORK_PATH} {
        proxy_pass http://xray:${NETWORK_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;

        proxy_read_timeout 3600;
        proxy_send_timeout 3600;
        proxy_buffering off;
    }
}
